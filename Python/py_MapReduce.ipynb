   "source": [
    "string = \"\"\n",
    "with open(\"/Dataset/input.txt\",'r') as file:\n",
    "    string = file.read()\n",
    "word_counts = dict()\n",
    "for i in string.split():\n",
    "    if i not in word_counts:\n",
    "        word_counts[i] = 0\n",
    "    word_counts[i] += 1\n",
    "for key in sorted(word_counts):\n",
    "    print(key, word_counts[key])"
   ]
